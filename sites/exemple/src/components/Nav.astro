---
// Navigation : une barre plate, typographique, qui s'efface derrière le contenu.
// Pas de verre. Un filet d'un pixel n'apparaît qu'une fois la page défilée.
// « Produits » ouvre un panneau ; sur mobile, « Menu » ouvre un panneau plein écran.
import { produits } from '../data/produits';

interface Props {
  current: 'accueil' | 'messenger';
  surHeros?: boolean;
}
const { current, surHeros = false } = Astro.props;
---
<header class:list={['barre', { 'sur-heros': surHeros }]} data-barre>
  <div class="barre-interieur conteneur">
    <a class="marque" href="/" aria-label="Droplet, accueil">Droplet</a>

    <nav class="liens" aria-label="Navigation principale">
      <button class="lien" type="button" aria-expanded="false" aria-controls="panneau-produits" data-ouvre="panneau-produits">
        Produits
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <a class="lien" href="/#chemin">Comment ça marche</a>
      <a class="lien" href="/#confidentialite">Sécurité</a>
    </nav>

    <div class="actions">
      <button class="icone" type="button" aria-label="Passer au thème sombre" data-theme-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
          <circle cx="12" cy="12" r="8" />
          <path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor" stroke="none" />
        </svg>
      </button>
      <a class="bouton bouton-principal bouton-petit telecharger" href="/#telecharger">Télécharger</a>
      <button class="menu-mobile label" type="button" aria-expanded="false" aria-controls="panneau-mobile" data-ouvre="panneau-mobile">Menu</button>
    </div>
  </div>

  <div class="panneau" id="panneau-produits" hidden>
    <ul class="conteneur produits-liste">
      {produits.map((p) => {
        const href = p.page ?? p.externe;
        return (
          <li>
            {href ? (
              <a class="produit" href={href} aria-current={current === p.id ? 'page' : undefined}>
                <span class="subtitle">{p.nom}</span>
                <span class="caption">{p.phrase}</span>
                <span class="technique doux">{p.plateforme}</span>
              </a>
            ) : (
              <div class="produit sans-page">
                <span class="subtitle">{p.nom}</span>
                <span class="caption">{p.phrase}</span>
                <span class="technique doux">{p.plateforme}</span>
                <span class="caption">Page à venir</span>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </div>

  <div class="panneau plein" id="panneau-mobile" hidden>
    <div class="conteneur plein-interieur">
      <p class="caption">Produits</p>
      <ul class="plein-liste">
        {produits.map((p) => {
          const href = p.page ?? p.externe;
          return <li>{href ? <a href={href} class="title">{p.nom}</a> : <span class="title doux">{p.nom}</span>}</li>;
        })}
      </ul>
      <ul class="plein-liste secondaire">
        <li><a href="/#chemin" class="subtitle">Comment ça marche</a></li>
        <li><a href="/#confidentialite" class="subtitle">Sécurité</a></li>
      </ul>
      <a class="bouton bouton-principal" href="/#telecharger">Télécharger</a>
    </div>
  </div>
</header>

<script>
  const barre = document.querySelector<HTMLElement>('[data-barre]')!;

  // Le filet (et le fond, au-dessus du héros) n'apparaît qu'après 8 px de défilement.
  const sync = () => barre.classList.toggle('defilee', scrollY > 8);
  addEventListener('scroll', sync, { passive: true });
  sync();

  // Panneaux : un seul ouvert à la fois ; Échap ou un clic ailleurs ferme.
  const boutons = [...barre.querySelectorAll<HTMLButtonElement>('[data-ouvre]')];
  const fermer = (sauf?: HTMLButtonElement) =>
    boutons.forEach((b) => {
      if (b === sauf) return;
      b.setAttribute('aria-expanded', 'false');
      document.getElementById(b.dataset.ouvre!)!.hidden = true;
    });
  boutons.forEach((b) =>
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const panneau = document.getElementById(b.dataset.ouvre!)!;
      const ouvrir = panneau.hidden;
      fermer(b);
      panneau.hidden = !ouvrir;
      b.setAttribute('aria-expanded', String(ouvrir));
      barre.classList.toggle('panneau-ouvert', ouvrir);
      document.documentElement.classList.toggle('sans-defilement', ouvrir && b.dataset.ouvre === 'panneau-mobile');
      if (ouvrir) panneau.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    }),
  );
  const toutFermer = () => {
    fermer();
    barre.classList.remove('panneau-ouvert');
    document.documentElement.classList.remove('sans-defilement');
  };
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.panneau')) toutFermer();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const ouvert = boutons.find((b) => b.getAttribute('aria-expanded') === 'true');
    toutFermer();
    ouvert?.focus();
  });

  // Thème
  const theme = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const libelle = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    theme?.setAttribute('aria-label', dark ? 'Passer au thème clair' : 'Passer au thème sombre');
  };
  libelle();
  theme?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    libelle();
  });
</script>

<style>
  .barre {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--fond);
    transition: background-color 150ms ease, box-shadow 150ms ease;
  }
  .barre.defilee,
  .barre.panneau-ouvert {
    box-shadow: 0 1px 0 var(--trait);
  }
  /* Sur l'accueil, la barre est posée sur la vitre jusqu'au premier défilement. */
  .barre.sur-heros {
    position: fixed;
    inset: 0 0 auto 0;
    background: transparent;
  }
  .barre.sur-heros.defilee,
  .barre.sur-heros.panneau-ouvert {
    background: var(--fond);
  }
  .barre-interieur {
    display: flex;
    align-items: center;
    gap: var(--e-6);
    height: 64px;
  }
  .marque {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variation-settings: 'FLAR' 100, 'VOLM' 40;
    text-decoration: none;
  }
  .liens {
    display: flex;
    gap: var(--e-5);
  }
  .lien {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0;
    border: 0;
    background: none;
    color: var(--encre-douce);
    font: 500 15px 'Commissioner', system-ui, sans-serif;
    text-decoration: none;
    cursor: pointer;
    transition: color 120ms ease;
  }
  .lien:hover,
  .lien[aria-expanded='true'] {
    color: var(--encre);
  }
  .lien svg {
    transition: transform 180ms var(--sortie);
  }
  .lien[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    margin-left: auto;
  }
  .icone {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--encre);
    cursor: pointer;
  }
  .icone:hover {
    background: color-mix(in srgb, var(--encre) 7%, transparent);
  }
  .menu-mobile {
    display: none;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--trait);
    border-radius: 999px;
    background: none;
    color: var(--encre);
    cursor: pointer;
  }

  /* Panneau Produits : apparaît depuis la barre, 180 ms. */
  .panneau {
    position: absolute;
    inset: 100% 0 auto 0;
    background: var(--fond);
    box-shadow: 0 1px 0 var(--trait), 0 24px 40px -24px rgb(0 0 0 / 0.25);
    transform-origin: top center;
    animation: panneau 180ms var(--sortie);
  }
  @keyframes panneau {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.985);
    }
  }
  .produits-liste {
    list-style: none;
    margin: 0 auto;
    padding: var(--e-5) 0 var(--e-6);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
  }
  .produits-liste li + li {
    border-left: 1px solid var(--trait);
  }
  .produit {
    display: grid;
    gap: 6px;
    align-content: start;
    height: 100%;
    padding: var(--e-3) var(--e-4);
    text-decoration: none;
    border-radius: var(--r-controle);
    transition: background-color 120ms ease;
  }
  a.produit:hover,
  a.produit:focus-visible {
    background: color-mix(in srgb, var(--encre) 5%, transparent);
  }
  .sans-page .subtitle {
    color: var(--encre-douce);
  }

  .plein {
    position: fixed;
    inset: 64px 0 0 0;
    overflow-y: auto;
    animation: plein 260ms var(--sortie);
  }
  @keyframes plein {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  .plein-interieur {
    display: grid;
    gap: var(--e-5);
    padding-block: var(--e-5) var(--e-8);
  }
  .plein-interieur p {
    margin: 0;
  }
  .plein-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e-3);
  }
  .plein-liste a {
    text-decoration: none;
  }
  .plein-liste.secondaire {
    padding-top: var(--e-4);
    border-top: 1px solid var(--trait);
  }

  @media (max-width: 860px) {
    .liens,
    .telecharger {
      display: none;
    }
    .menu-mobile {
      display: inline-block;
    }
  }
  @media (min-width: 861px) {
    #panneau-mobile {
      display: none !important;
    }
  }
</style>
