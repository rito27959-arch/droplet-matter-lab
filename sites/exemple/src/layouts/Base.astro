---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description: string;
  current?: 'accueil' | 'composants';
}
const { title, description, current = 'accueil' } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/commissioner.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Thème appliqué avant le premier affichage : choix mémorisé, sinon celui du système.
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        var q = new URLSearchParams(location.search).get('theme');
        if (q === 'dark' || q === 'light') t = q;
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <Nav current={current} />
    <main id="contenu">
      <slot />
    </main>
    <footer class="pied conteneur">
      <p class="caption">
        Site d’exemple du Droplet Design Language, pour validation. Aucune page de dropletmesh.app n’a été modifiée.
      </p>
      <p class="caption">
        Polices sous SIL Open Font License 1.1 : Commissioner, Martian Mono, Newsreader.
        Fonds de la vitre dessinés par programme.
      </p>
    </footer>
  </body>
</html>

<style>
  .evitement {
    position: absolute;
    left: -9999px;
  }
  .evitement:focus {
    left: 16px;
    top: 16px;
    z-index: 100;
    background: var(--surface-haute);
    padding: 8px 12px;
    border-radius: 8px;
  }
  .pied {
    border-top: 1px solid var(--trait);
    padding-block: var(--e-6) var(--e-8);
    margin-top: var(--e-9);
    display: grid;
    gap: var(--e-2);
  }
  .pied p {
    margin: 0;
    max-width: 68ch;
  }
</style>
