---
import Base from '../layouts/Base.astro';

const i = {
  plus: 'M12 5v14M5 12h14',
  partager: 'M12 15V4M8 8l4-4 4 4M6 12v7h12v-7',
  plume: 'M4 20h4L19 9l-4-4L4 16v4Z',
  plusieurs: 'M6 12h.01M12 12h.01M18 12h.01',
  retour: 'M15 5l-7 7 7 7',
  chercher: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm5-2 4 4',
  discussions: 'M4 5h16v11H8l-4 4Z',
  appels: 'M6 3h3l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z',
  autour: 'M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0M6 12a6 6 0 0 1 12 0M3 12a9 9 0 0 1 18 0',
  profil: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0',
  copier: 'M8 8h11v11H8zM5 16V5h11',
  epingler: 'M12 17v4M8 3h8l-1 6 3 4H6l3-4Z',
  muet: 'M11 5 6 9H3v6h3l5 4V5ZM22 9l-6 6M16 9l6 6',
  supprimer: 'M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3',
  annuler: 'M9 14 4 9l5-5M4 9h11a5 5 0 0 1 0 10h-3',
  retablir: 'M15 14l5-5-5-5M20 9H9a5 5 0 0 0 0 10h3',
  photo: 'M4 7h4l2-3h4l2 3h4v12H4ZM12 16a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
};
const Icone = (d: string, taille = 20) =>
  `<svg width="${taille}" height="${taille}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;

const discussions = [
  { nom: 'Amina Ndzie', apercu: 'Je viens vers toi', heure: '17:04', teinte: 'linear-gradient(135deg,#7aa7ff,#c38bff)' },
  { nom: 'Famille', apercu: 'Papa : au marché à 17 h', heure: '16:38', teinte: 'linear-gradient(135deg,#ffb36b,#ff6f91)' },
  { nom: 'Bilal Kamga', apercu: 'La photo du chantier', heure: '15:12', teinte: 'linear-gradient(135deg,#5fe0c2,#3d8bff)' },
  { nom: 'Léa', apercu: 'Merci !', heure: '14:50', teinte: 'linear-gradient(135deg,#ff8fb1,#ffd36e)' },
  { nom: 'Cours de maths', apercu: 'Exercice 4 corrigé', heure: '12:31', teinte: 'linear-gradient(135deg,#a1ffce,#4fa3ff)' },
  { nom: 'Chantier Mvan', apercu: 'Relayé par 3 téléphones', heure: '11:02', teinte: 'linear-gradient(135deg,#c9b6ff,#6a7dff)' },
  { nom: 'Voisins', apercu: 'Coupure jusqu’à 20 h', heure: 'Hier', teinte: 'linear-gradient(135deg,#ffd36e,#ff8a5b)' },
  { nom: 'Club de foot', apercu: 'Match samedi 9 h', heure: 'Hier', teinte: 'linear-gradient(135deg,#79f0a3,#2bb3c0)' },
  { nom: 'Mama', apercu: 'Appelle quand tu peux', heure: 'Lun.', teinte: 'linear-gradient(135deg,#ff9a9e,#fad0c4)' },
];
const onglets = [
  { label: 'Discussions', d: i.discussions },
  { label: 'Appels', d: i.appels },
  { label: 'Autour', d: i.autour },
  { label: 'Profil', d: i.profil },
];
---
<Base title="Composants — verre liquide Droplet" description="Tous les composants du Droplet Design Language, en verre liquide." current="composants">
  <div class="papier" aria-hidden="true"></div>

  <header class="tete conteneur">
    <h1 class="display">Composants</h1>
    <p class="chapo">
      Tous les contrôles sont faits d’une même matière : un verre liquide qui courbe la lumière à son bord, attrape un reflet
      du côté de la lumière et se déforme quand on le touche. Bougez la souris, appuyez, faites glisser.
    </p>

    <div class="reglage lg" data-lens>
      <div class="reglage-ligne">
        <span class="label">Verre</span>
        <span class="caption">Très clair</span>
        <div class="lgc" role="slider" tabindex="0" aria-label="Transparence du verre" aria-valuemin="0" aria-valuemax="100" aria-valuenow="35" data-voile>
          <span class="lgc-piste"><span class="lgc-rempli"></span></span>
          <span class="lgc-pouce lg"></span>
        </div>
        <span class="caption">Teinté</span>
      </div>
      <button class="lgs" type="button" role="switch" aria-checked="false" data-contraste>
        <span class="label">Augmenter le contraste</span>
        <span class="lgs-piste"><span class="lgs-pouce lg"></span></span>
      </button>
    </div>
  </header>

  <div class="conteneur plan">
    <section class="bloc" aria-labelledby="t-boutons">
      <h2 id="t-boutons" class="title">Boutons</h2>
      <div class="rangee">
        <button class="lgb lg" type="button">Verre</button>
        <button class="lgb lg lg-proeminent" type="button">Proéminent</button>
        <button class="lgb lg lg-clair" type="button">Clair</button>
        <button class="lgb lg" type="button" disabled>Indisponible</button>
      </div>
      <div class="rangee">
        <button class="lgb lg lgb-petit" type="button">Petit</button>
        <button class="lgb lg" type="button">Normal</button>
        <button class="lgb lg lgb-grand" type="button">Grand</button>
        <button class="lgb lg lg-proeminent lgb-tres-grand" type="button">Très grand</button>
      </div>
      <div class="rangee">
        <button class="lgb lg lgb-icone" type="button" aria-label="Nouveau message" set:html={Icone(i.plume)} />
        <button class="lgb lg lgb-icone" type="button" aria-label="Partager" set:html={Icone(i.partager)} />
        <button class="lgb lg lg-proeminent lgb-icone lgb-grand" type="button" aria-label="Ajouter" set:html={Icone(i.plus, 24)} />
        <button class="lgb lg" type="button"><Fragment set:html={Icone(i.photo, 18)} /> Envoyer une photo</button>
      </div>
    </section>

    <section class="bloc" aria-labelledby="t-choix">
      <h2 id="t-choix" class="title">Interrupteurs, curseurs, pas à pas</h2>
      <div class="pile lg plaque" data-lens>
        <button class="lgs" type="button" role="switch" aria-checked="true">
          <span class="label">Servir de relais</span>
          <span class="lgs-piste"><span class="lgs-pouce lg"></span></span>
        </button>
        <button class="lgs" type="button" role="switch" aria-checked="false">
          <span class="label">Économiser la batterie</span>
          <span class="lgs-piste"><span class="lgs-pouce lg"></span></span>
        </button>
        <div class="ligne-curseur">
          <span class="label">Portée</span>
          <div class="lgc" role="slider" tabindex="0" aria-label="Portée de découverte" aria-valuemin="10" aria-valuemax="200" aria-valuenow="90" data-unit="m" data-affiche="portee">
            <span class="lgc-piste"><span class="lgc-rempli"></span></span>
            <span class="lgc-pouce lg"></span>
          </div>
          <output class="technique" id="portee">90 m</output>
        </div>
        <div class="ligne-curseur">
          <span class="label">Sauts maximum</span>
          <div class="lgp lg" data-min="1" data-max="5">
            <button type="button" aria-label="Un saut de moins" set:html={Icone('M5 12h14', 18)} />
            <output class="technique" aria-live="polite">5</output>
            <button type="button" aria-label="Un saut de plus" set:html={Icone(i.plus, 18)} />
          </div>
        </div>
      </div>
    </section>

    <section class="bloc" aria-labelledby="t-segmente">
      <h2 id="t-segmente" class="title">Contrôle segmenté et puces</h2>
      <div class="segmente lg" role="radiogroup" aria-label="Afficher" data-segmente>
        <span class="lentille lg lg-clair" aria-hidden="true"></span>
        <button type="button" role="radio" aria-checked="true">Tout</button>
        <button type="button" role="radio" aria-checked="false">Non lus</button>
        <button type="button" role="radio" aria-checked="false">Groupes</button>
        <button type="button" role="radio" aria-checked="false">En attente</button>
      </div>
      <div class="rangee" role="group" aria-label="Filtres">
        <button class="lgb lg lgb-petit puce" type="button" aria-pressed="true">Proches</button>
        <button class="lgb lg lgb-petit puce" type="button" aria-pressed="false">Chiffrés</button>
        <button class="lgb lg lgb-petit puce" type="button" aria-pressed="false">Avec fichiers</button>
      </div>
    </section>

    <section class="bloc" aria-labelledby="t-champs">
      <h2 id="t-champs" class="title">Champs</h2>
      <label class="champ lg" data-lens>
        <span class="caption">Nom affiché</span>
        <input type="text" value="Amina" autocomplete="off" />
      </label>
      <label class="recherche lg" data-lens>
        <Fragment set:html={Icone(i.chercher, 18)} />
        <input type="search" placeholder="Rechercher une discussion" aria-label="Rechercher une discussion" />
      </label>
      <label class="champ lg erreur" data-lens>
        <span class="caption">Code de jumelage</span>
        <input type="text" class="technique" value="4F2A-9" aria-invalid="true" aria-describedby="err-code" />
        <span class="caption" id="err-code">Le code a 8 caractères. Vérifiez l’écran de l’autre téléphone.</span>
      </label>
    </section>

    <section class="bloc" aria-labelledby="t-outils">
      <h2 id="t-outils" class="title">Barre d’outils, menu, popover</h2>
      <p class="note">Les actions proches partagent le même morceau de verre. Le menu naît du bouton qui l’ouvre.</p>
      <div class="outils hote">
        <div class="lg-groupe lg">
          <button type="button" aria-label="Annuler" set:html={Icone(i.annuler)} />
          <button type="button" aria-label="Rétablir" set:html={Icone(i.retablir)} />
        </div>
        <div class="lg-groupe lg">
          <button type="button" aria-label="Partager" set:html={Icone(i.partager)} />
          <button type="button" aria-label="Plus d’actions" data-menu="menu-outils" set:html={Icone(i.plusieurs, 22)} />
        </div>
        <button class="lgb lg" type="button" data-menu="pop-info">Infos du relais</button>

        <div class="menu lg" id="menu-outils" role="menu" aria-label="Actions" hidden>
          <button role="menuitem" type="button"><Fragment set:html={Icone(i.copier, 18)} />Copier</button>
          <button role="menuitem" type="button"><Fragment set:html={Icone(i.epingler, 18)} />Épingler</button>
          <button role="menuitem" type="button"><Fragment set:html={Icone(i.muet, 18)} />Mettre en sourdine</button>
          <hr />
          <button role="menuitem" type="button" class="danger"><Fragment set:html={Icone(i.supprimer, 18)} />Supprimer</button>
        </div>
        <div class="menu pop lg" id="pop-info" role="dialog" aria-label="Infos du relais" hidden>
          <p class="subtitle">Relais actif</p>
          <dl class="technique">
            <div><dt>Voisins</dt><dd>3</dd></div>
            <div><dt>Messages transmis</dt><dd>128</dd></div>
            <div><dt>Batterie utilisée</dt><dd>2 %</dd></div>
          </dl>
          <button class="lgb lg lgb-petit" type="button" data-ferme>Fermer</button>
        </div>
      </div>
    </section>

    <section class="bloc" aria-labelledby="t-liste">
      <h2 id="t-liste" class="title">Listes groupées</h2>
      <ul class="groupe lg" data-lens>
        <li><span>Notifications</span><span class="doux">Activées</span></li>
        <li><span>Confidentialité</span><span class="doux">Contacts</span></li>
        <li><span>Stockage</span><span class="technique doux">1,2 Go</span></li>
      </ul>
    </section>
  </div>

  <section class="conteneur demo" aria-labelledby="t-demo">
    <div class="demo-texte">
      <h2 id="t-demo" class="headline">Dans une app</h2>
      <p class="chapo">
        Faites défiler la liste : la barre d’onglets se réduit, puis revient. Le bouton crayon ouvre une feuille, que l’on
        tire vers le haut. Le bouton partager fait naître une feuille d’action. La loupe ouvre la recherche.
      </p>
    </div>

    <div class="telephone">
      <div class="ecran" data-ecran>
        <div class="defile" data-defile>
          <h3 class="grand-titre">Discussions</h3>
          <ul class="convs">
            {discussions.map((d) => (
              <li>
                <span class="photo" style={`background:${d.teinte}`}>{d.nom.slice(0, 1)}</span>
                <span class="conv-texte"><span class="label">{d.nom}</span><span class="caption">{d.apercu}</span></span>
                <span class="technique doux heure">{d.heure}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bord-defilement" data-bord aria-hidden="true"></div>

        <div class="barre-haut">
          <div class="lg-groupe lg">
            <button type="button" aria-label="Partager l’invitation" data-action-sheet set:html={Icone(i.partager)} />
            <button type="button" aria-label="Nouveau message" data-ouvre-feuille set:html={Icone(i.plume)} />
          </div>
        </div>

        <nav class="onglets" aria-label="Onglets de l’app">
          <div class="onglets-barre lg" data-onglets>
            <span class="lentille lg lg-clair" aria-hidden="true"></span>
            {onglets.map((o, k) => (
              <button type="button" class="onglet" aria-current={k === 0 ? 'page' : undefined}>
                <Fragment set:html={Icone(o.d, 22)} />
                <span>{o.label}</span>
              </button>
            ))}
          </div>
          <button class="onglet-recherche lg lgb lgb-icone" type="button" aria-label="Rechercher" data-recherche set:html={Icone(i.chercher, 22)} />
          <label class="recherche-ouverte lg" data-recherche-champ hidden>
            <Fragment set:html={Icone(i.chercher, 18)} />
            <input type="search" placeholder="Rechercher" aria-label="Rechercher" />
            <button type="button" class="lgb lg lgb-petit lgb-icone" aria-label="Fermer la recherche" data-recherche-fermer>✕</button>
          </label>
        </nav>

        <div class="feuille-action lg" role="menu" aria-label="Partager l’invitation" data-feuille-action hidden>
          <button role="menuitem" type="button">Copier le lien</button>
          <button role="menuitem" type="button">Afficher le code QR</button>
          <button role="menuitem" type="button">Envoyer par Bluetooth</button>
        </div>

        <div class="voile" data-voile-feuille hidden></div>
        <div class="feuille lg" role="dialog" aria-modal="true" aria-labelledby="t-feuille" data-feuille hidden>
          <span class="poignee" aria-hidden="true"></span>
          <div class="feuille-tete">
            <button class="lgb lg lgb-petit lgb-icone" type="button" aria-label="Fermer" data-ferme-feuille>✕</button>
            <h4 id="t-feuille" class="subtitle">Nouveau message</h4>
            <button class="lgb lg lg-proeminent lgb-petit" type="button" data-alerte>Supprimer</button>
          </div>
          <label class="recherche lg">
            <Fragment set:html={Icone(i.chercher, 18)} />
            <input type="search" placeholder="À : nom ou numéro" aria-label="Destinataire" />
          </label>
          <ul class="convs petite">
            {discussions.slice(0, 5).map((d) => (
              <li><span class="photo" style={`background:${d.teinte}`}>{d.nom.slice(0, 1)}</span><span class="label">{d.nom}</span></li>
            ))}
          </ul>
        </div>

        <div class="voile alerte-voile" data-voile-alerte hidden></div>
        <div class="alerte lg" role="alertdialog" aria-modal="true" aria-labelledby="t-alerte" aria-describedby="d-alerte" data-alerte-boite hidden>
          <h4 id="t-alerte" class="subtitle">Supprimer le brouillon ?</h4>
          <p id="d-alerte" class="caption">Le message n’a pas encore été envoyé.</p>
          <div class="alerte-boutons">
            <button class="lgb lg" type="button" data-alerte-non>Garder</button>
            <button class="lgb lg lg-proeminent" type="button" data-alerte-oui>Supprimer</button>
          </div>
        </div>

        <div class="toast lg" role="status" aria-live="polite" data-toast></div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { lensAll, followLight, lens, Spring, animate } from '../scripts/liquid';
  import { initSwitch, initSlider, initLiquidSelect, initStepper, initMorph } from '../scripts/controles';

  followLight();

  // Réglage global du verre (iOS 27 : de très clair à teinté) et du contraste.
  const root = document.documentElement;
  const voileEl = document.querySelector<HTMLElement>('[data-voile]')!;
  const saved = (() => { try { return localStorage.getItem('voile'); } catch { return null; } })();
  if (saved) {
    voileEl.setAttribute('aria-valuenow', saved);
    root.style.setProperty('--lg-voile', String(Number(saved) / 100));
  }
  document.querySelectorAll<HTMLElement>('.lgc').forEach((el) =>
    initSlider(el, (v) => {
      if (el.hasAttribute('data-voile')) {
        root.style.setProperty('--lg-voile', String(v / 100));
        try { localStorage.setItem('voile', String(v)); } catch {}
      }
      const out = el.dataset.affiche ? document.getElementById(el.dataset.affiche) : null;
      if (out) out.textContent = `${v} ${el.dataset.unit ?? ''}`.trim();
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('.lgs').forEach(initSwitch);
  document.querySelector('[data-contraste]')?.addEventListener('change', (e) => {
    root.style.setProperty('--lg-contraste', (e.currentTarget as HTMLElement).getAttribute('aria-checked') === 'true' ? '1' : '0');
  });

  document.querySelectorAll<HTMLElement>('.lgp').forEach(initStepper);
  document.querySelectorAll<HTMLButtonElement>('.puce').forEach((b) =>
    b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))),
  );

  // Contrôle segmenté
  document.querySelectorAll<HTMLElement>('[data-segmente]').forEach((g) =>
    initLiquidSelect(g, [...g.querySelectorAll<HTMLElement>('[role=radio]')], g.querySelector('.lentille')!),
  );

  // Menus et popovers qui naissent de leur bouton
  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((t) => {
    const panel = document.getElementById(t.dataset.menu!)!;
    initMorph(t, panel, { align: t.dataset.menu === 'menu-outils' ? 'fin' : 'debut' });
  });

  // Tous les verres reçoivent leur réfraction de bord (Chromium).
  document.querySelectorAll<HTMLElement>('.lgb, .lg-groupe, .segmente, .lgp, .onglets-barre, .toast').forEach((el) => {
    el.dataset.lens = el.dataset.lens || 'bord';
  });
  lensAll();

  /* ---------- L'app de démonstration ---------- */
  const ecran = document.querySelector<HTMLElement>('[data-ecran]')!;
  const defile = ecran.querySelector<HTMLElement>('[data-defile]')!;
  const bord = ecran.querySelector<HTMLElement>('[data-bord]')!;
  const barre = ecran.querySelector<HTMLElement>('[data-onglets]')!;
  const nav = ecran.querySelector<HTMLElement>('.onglets')!;
  initLiquidSelect(barre, [...barre.querySelectorAll<HTMLElement>('.onglet')], barre.querySelector('.lentille')!, undefined, 'aria-current');

  // La barre d'onglets se réduit quand on descend, revient quand on remonte.
  let last = 0;
  defile.addEventListener('scroll', () => {
    const y = defile.scrollTop;
    bord.classList.toggle('visible', y > 4);
    if (Math.abs(y - last) < 6) return;
    nav.classList.toggle('reduite', y > last && y > 40);
    last = y;
  });

  // Toast
  const toast = ecran.querySelector<HTMLElement>('[data-toast]')!;
  let tt = 0;
  const montrer = (texte: string) => {
    toast.textContent = texte;
    toast.classList.add('visible');
    clearTimeout(tt);
    tt = window.setTimeout(() => toast.classList.remove('visible'), 2200);
  };

  // Feuille d'action : naît du bouton partager
  const sa = ecran.querySelector<HTMLElement>('[data-feuille-action]')!;
  const saTrigger = ecran.querySelector<HTMLElement>('[data-action-sheet]')!;
  initMorph(saTrigger, sa, { align: 'fin' });
  sa.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => montrer(b.textContent === 'Copier le lien' ? 'Lien copié' : 'Fait')));

  // Feuille : à mi-hauteur, décollée des bords ; tirée vers le haut, elle devient opaque.
  const feuille = ecran.querySelector<HTMLElement>('[data-feuille]')!;
  const voileF = ecran.querySelector<HTMLElement>('[data-voile-feuille]')!;
  lens(feuille, { bezel: 18, thickness: 20 });
  const fy = new Spring(1, 260, 0.82); // 0 plein écran, 0.45 mi-hauteur, 1 fermée
  let feuilleOuverte = false;
  const rendreFeuille = () => {
    const h = ecran.clientHeight;
    const y = fy.x * h;
    feuille.style.transform = `translateY(${y}px)`;
    const plein = 1 - Math.min(Math.max((fy.x - 0.02) / 0.43, 0), 1);
    feuille.style.setProperty('--plein', String(plein));
    feuille.classList.toggle('lg-opaque', plein > 0.6);
    voileF.style.opacity = String(Math.max(0, 1 - fy.x) * 0.5);
    if (fy.x > 0.99 && !feuilleOuverte) {
      feuille.hidden = true;
      voileF.hidden = true;
    }
  };
  const bougerFeuille = (target: number) => {
    fy.target = target;
    animate((dt) => {
      fy.step(dt);
      rendreFeuille();
      return !fy.resting;
    });
  };
  const ouvrirFeuille = () => {
    feuilleOuverte = true;
    feuille.hidden = false;
    voileF.hidden = false;
    bougerFeuille(0.45);
    setTimeout(() => feuille.querySelector('input')?.focus({ preventScroll: true }), 300);
  };
  const fermerFeuille = () => {
    feuilleOuverte = false;
    bougerFeuille(1);
  };
  ecran.querySelector('[data-ouvre-feuille]')!.addEventListener('click', ouvrirFeuille);
  ecran.querySelector('[data-ferme-feuille]')!.addEventListener('click', fermerFeuille);
  voileF.addEventListener('click', fermerFeuille);
  const poignee = feuille.querySelector<HTMLElement>('.poignee')!;
  let drag: { y: number; from: number } | null = null;
  const debutTirer = (e: PointerEvent) => {
    if ((e.target as HTMLElement).closest('button, input, li')) return;
    drag = { y: e.clientY, from: fy.x };
    feuille.setPointerCapture(e.pointerId);
  };
  feuille.addEventListener('pointerdown', debutTirer);
  feuille.addEventListener('pointermove', (e) => {
    if (!drag) return;
    fy.x = fy.target = Math.min(Math.max(drag.from + (e.clientY - drag.y) / ecran.clientHeight, -0.02), 1);
    rendreFeuille();
  });
  feuille.addEventListener('pointerup', () => {
    if (!drag) return;
    const p = fy.x;
    drag = null;
    if (p < 0.22) bougerFeuille(0.02);
    else if (p < 0.7) bougerFeuille(0.45);
    else fermerFeuille();
  });
  poignee.addEventListener('dblclick', () => bougerFeuille(fy.target < 0.2 ? 0.45 : 0.02));
  ecran.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && feuilleOuverte) fermerFeuille();
  });

  // Alerte
  const alerte = ecran.querySelector<HTMLElement>('[data-alerte-boite]')!;
  const voileA = ecran.querySelector<HTMLElement>('[data-voile-alerte]')!;
  lens(alerte, { bezel: 16, thickness: 18 });
  const montrerAlerte = (o: boolean) => {
    alerte.hidden = voileA.hidden = !o;
    if (o) {
      alerte.animate?.([{ transform: 'translate(-50%, -50%) scale(1.15)', opacity: 0 }, { transform: 'translate(-50%, -50%) scale(1)', opacity: 1 }], { duration: 380, easing: 'cubic-bezier(0.34,1.36,0.64,1)' });
      alerte.querySelector<HTMLElement>('button')?.focus();
    }
  };
  ecran.querySelector('[data-alerte]')!.addEventListener('click', () => montrerAlerte(true));
  ecran.querySelector('[data-alerte-non]')!.addEventListener('click', () => montrerAlerte(false));
  ecran.querySelector('[data-alerte-oui]')!.addEventListener('click', () => {
    montrerAlerte(false);
    fermerFeuille();
    montrer('Brouillon supprimé');
  });

  // Recherche : le bouton loupe s'étire en champ.
  const rBtn = ecran.querySelector<HTMLElement>('[data-recherche]')!;
  const rChamp = ecran.querySelector<HTMLElement>('[data-recherche-champ]')!;
  lens(rChamp);
  rBtn.addEventListener('click', () => {
    nav.classList.add('cherche');
    rChamp.hidden = false;
    rChamp.animate?.([{ clipPath: 'inset(0 0 0 calc(100% - 52px) round 26px)' }, { clipPath: 'inset(0 0 0 0 round 26px)' }], { duration: 420, easing: 'cubic-bezier(0.34,1.2,0.64,1)' });
    rChamp.querySelector('input')?.focus({ preventScroll: true });
  });
  ecran.querySelector('[data-recherche-fermer]')!.addEventListener('click', () => {
    nav.classList.remove('cherche');
    rChamp.hidden = true;
    rBtn.focus();
  });
</script>

