---
// ============================================================================
// PROTOTYPE — Droplet Pro, à la façon de Telegram Premium sur iOS.
// ----------------------------------------------------------------------------
// Trois écrans de l'app, dessinés dans un vrai téléphone pour être validés
// AVANT d'être écrits en Flutter :
//   1. la vitrine (emblème animé, offres, liste des avantages) ;
//   2. la présentation d'un avantage (un téléphone par avantage, qu'on fait
//      glisser ; chacun joue sa petite scène) ;
//   3. le paiement Mobile Money (offre, opérateur, numéro, attente, succès).
// Construction reprise de l'idée de Telegram (téléphone recadré en haut ou en
// bas, glissement en perspective, points de page), mais rien n'est copié :
// le code de Telegram iOS est sous GPL. Textes : ceux de l'app (app_fr.arb).
// AUCUN PAIEMENT : rien n'est envoyé, le numéro ne quitte pas la page.
// ============================================================================
const avantages = [
  { cle: 'vocaux', titre: 'Vocaux en texte', court: "Lire un vocal sans l'écouter", long: "La transcription se fait sur votre téléphone, hors ligne. Le vocal ne part nulle part, et vous le lisez en réunion, dans le bus, ou quand le réseau n'est pas là.", icone: 'onde' },
  { cle: 'forme', titre: 'Mise en forme', court: 'Gras, italique, code, spoiler', long: "Un mot en gras, une ligne de code, un passage masqué qu'on découvre d'un toucher : votre message dit exactement ce que vous vouliez, et rien d'autre.", icone: 'texte' },
  { cle: 'fonds', titre: 'Fonds et motifs', court: 'Toute la galerie, et les quatre packs', long: "Chaque fond est dessiné à la main. Droplet, Jeux, Maison, Jardin : votre écran de discussion ne ressemble à aucun autre.", icone: 'fond' },
  { cle: 'traduction', titre: 'Traduction', court: "Comprendre sans quitter l'app", long: "Le message est traduit sur votre téléphone : son contenu ne part chez personne. L'original reste à un toucher, parce qu'une traduction n'est jamais tout à fait le texte.", icone: 'langue' },
  { cle: 'autocollants', titre: 'Autocollants animés', court: 'La goutte Droplet, en mouvement', long: "Des autocollants dessinés pour Droplet, animés image par image, et légers : ils voyagent même par le maillage, sans Internet.", icone: 'etincelle' },
  { cle: 'icones', titre: "Icônes d'app", court: "Changer l'icône sur l'écran d'accueil", long: "Une app de messagerie discrète, ça commence par son icône. Choisissez celle qui vous ressemble, ou celle qu'on remarque le moins.", icone: 'grille' },
  { cle: 'badge', titre: 'Badge Pro', court: 'Il accompagne votre nom', long: "Il ne donne aucun pouvoir sur les autres. Il dit seulement que vous avez payé pour que Droplet reste sans publicité, sans abonnement obligatoire et sans revente de données.", icone: 'badge' },
];
// Le dégradé des avantages de l'app (fonctions_premium.dart).
const palette = ['#6C51FF', '#8E4FFF', '#B44BF0', '#E151B0', '#F2586B', '#F97C3C', '#FFA932'];
const icones: Record<string, string> = {
  onde: '<path d="M4 12h1M8 8v8M12 5v14M16 9v6M20 11v2" stroke-linecap="round"/>',
  texte: '<path d="M5 6h14M12 6v13M8 19h8" stroke-linecap="round"/>',
  fond: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M4 15l5-5 4 4 3-3 4 4" stroke-linejoin="round"/>',
  langue: '<path d="M4 6h9M8.5 4v2M6 6c1 4 3 6 6 7M11 6c-1 4-3 6-6 7M13 20l4-9 4 9M14.5 17h5" stroke-linecap="round" stroke-linejoin="round"/>',
  etincelle: '<path d="M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" stroke-linejoin="round"/>',
  grille: '<rect x="4" y="4" width="6" height="6" rx="1.5"/><rect x="14" y="4" width="6" height="6" rx="1.5"/><rect x="4" y="14" width="6" height="6" rx="1.5"/><rect x="14" y="14" width="6" height="6" rx="1.5"/>',
  badge: '<path d="M12 3l2.4 1.6 2.9-.2.9 2.8 2.3 1.8-1 2.7 1 2.7-2.3 1.8-.9 2.8-2.9-.2L12 21l-2.4-1.6-2.9.2-.9-2.8-2.3-1.8 1-2.7-1-2.7 2.3-1.8.9-2.8 2.9.2z"/><path d="M8.5 12l2.3 2.3 4.7-4.6" stroke-linecap="round" stroke-linejoin="round"/>',
};
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Droplet Pro — prototype</title>
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/commissioner.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <div class="scene">
    <div class="appareil" id="appareil">
      <div class="ilot" aria-hidden="true"></div>
      <div class="ecran" id="ecran">

        <!-- ═══ 1. LA VITRINE ═══ -->
        <header class="nav" id="nav">
          <button class="rond" type="button" aria-label="Retour"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
          <p class="nav__titre">Droplet Pro</p>
          <span class="rond rond--vide"></span>
        </header>

        <div class="defile" id="defile">
          <section class="heros">
            <canvas class="heros__etoiles" id="etoiles" aria-hidden="true"></canvas>
            <div class="embleme" aria-hidden="true">
              <svg viewBox="0 0 120 140">
                <defs>
                  <linearGradient id="g-goutte" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#8E7BFF" /><stop offset="0.5" stop-color="#E151B0" /><stop offset="1" stop-color="#FFA932" />
                  </linearGradient>
                  <radialGradient id="g-reflet" cx="0.35" cy="0.3" r="0.6">
                    <stop offset="0" stop-color="#fff" stop-opacity="0.85" /><stop offset="0.35" stop-color="#fff" stop-opacity="0.12" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
                  </radialGradient>
                </defs>
                <path d="M60 6C60 6 16 58 16 88a44 44 0 0 0 88 0C104 58 60 6 60 6z" fill="url(#g-goutte)" />
                <path d="M60 6C60 6 16 58 16 88a44 44 0 0 0 88 0C104 58 60 6 60 6z" fill="url(#g-reflet)" />
                <path d="M44 74c-4 8-4 18 2 25" stroke="#fff" stroke-opacity="0.7" stroke-width="5" stroke-linecap="round" fill="none" />
              </svg>
            </div>
            <h1>Droplet Pro</h1>
            <p class="heros__texte">Vos vocaux en texte, la traduction, les autocollants animés, toute la galerie. Payé une fois, à vous pour toujours.</p>
            <ul class="garanties">
              <li>Paiement unique</li><li>Sans abonnement</li><li>Marche hors ligne</li>
            </ul>
          </section>

          <ul class="offres groupe" role="radiogroup" aria-label="Offre">
            <li><button class="offre" type="button" role="radio" aria-checked="true" data-offre="pro" data-prix="1 000">
              <span class="radio"></span>
              <span class="offre__nom"><b>Droplet Pro</b><small>une fois, à vie</small></span>
              <span class="pastille">Le plus complet</span>
              <span class="offre__prix">1 000 F</span>
            </button></li>
            <li><button class="offre" type="button" role="radio" aria-checked="false" data-offre="pack" data-prix="500">
              <span class="radio"></span>
              <span class="offre__nom"><b>Le pack</b><small>une fois · dix icônes, huit fonds</small></span>
              <span class="offre__prix">500 F</span>
            </button></li>
          </ul>

          <h2 class="intertitre">Ce que Pro apporte</h2>
          <ul class="groupe avantages">
            {avantages.map((a, i) => (
              <li><button class="avantage" type="button" data-page={i}>
                <span class="carre" style={`--c:${palette[i]}`}><svg viewBox="0 0 24 24" set:html={icones[a.icone]} /></span>
                <span class="avantage__txt"><b>{a.titre}</b><small>{a.court}</small></span>
                <svg class="chevron" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
              </button></li>
            ))}
          </ul>

          <section class="jamais">
            <h2>Ce que Droplet<br />ne demandera jamais</h2>
            <p>Ni publicité, ni abonnement obligatoire, ni revente de vos données — il n'y a même pas de serveur pour les recueillir. Le pack et Pro financent le reste.</p>
          </section>
          <div class="reserve"></div>
        </div>

        <footer class="achat">
          <button class="cta" type="button" id="cta"><span>Débloquer pour <b id="cta-prix">1 000</b> F</span><i class="cta__reflet"></i></button>
          <p class="achat__note">Payé une fois par Mobile Money · aucun prélèvement ensuite</p>
          <button class="lien" type="button">Déjà payé ? Restaurer</button>
        </footer>

        <!-- ═══ 2. LA PRÉSENTATION DES AVANTAGES ═══ -->
        <div class="voile" id="voile" hidden></div>
        <section class="feuille feuille--demo" id="demo" aria-hidden="true" aria-label="Avantages de Droplet Pro">
          <div class="demo__scene" id="demo-scene">
            <canvas class="demo__deco" id="deco" aria-hidden="true"></canvas>
            <div class="demo__piste" id="piste">
              {avantages.map((a, i) => (
                <div class="page" data-i={i}>
                  <div class={`tel ${i % 2 ? 'tel--bas' : 'tel--haut'}`}>
                    <div class="tel__ecran">
                      <div class={`scenario scenario--${a.cle}`}>
                        {a.cle === 'vocaux' && (
                          <div class="fil">
                            <div class="bulle bulle--recu vocal"><span class="lecture"></span><span class="onde">{Array.from({ length: 22 }, (_, k) => <i style={`--h:${0.25 + Math.abs(Math.sin(k * 1.7)) * 0.75}`}></i>)}</span><span class="duree">0:14</span><span class="aA">→A</span></div>
                            <div class="transcription">« Je suis devant la gare, il pleut, je t'attends sous l'abri bleu. Prends un parapluie ! »</div>
                          </div>
                        )}
                        {a.cle === 'forme' && (
                          <div class="fil">
                            <div class="bulle bulle--envoye forme">Rendez-vous <b>demain 9 h</b>, <em>pas avant</em>. Le code du portail : <code>4F2A</code>. Et la surprise : <span class="spoiler"><span>un gâteau</span></span></div>
                          </div>
                        )}
                        {a.cle === 'fonds' && (
                          <div class="fil fil--fond">
                            <div class="bulle bulle--recu">On essaie le nouveau fond ?</div>
                            <div class="bulle bulle--envoye">Il change à chaque fois 😄</div>
                          </div>
                        )}
                        {a.cle === 'traduction' && (
                          <div class="fil">
                            <div class="bulle bulle--recu trad">See you at the station at nine, bring an umbrella!<span class="trad__fr">On se voit à la gare à neuf heures, prends un parapluie !</span><span class="trad__etiquette">Traduit de l'anglais</span></div>
                          </div>
                        )}
                        {a.cle === 'autocollants' && (
                          <div class="fil fil--centre">
                            <svg class="goutte-anim" viewBox="0 0 120 140"><path d="M60 8C60 8 18 58 18 88a42 42 0 0 0 84 0C102 58 60 8 60 8z" fill="#3E9BFF"/><circle cx="46" cy="86" r="7" fill="#fff"/><circle cx="74" cy="86" r="7" fill="#fff"/><circle cx="47" cy="87" r="3.4" fill="#10203a"/><circle cx="75" cy="87" r="3.4" fill="#10203a"/><path d="M50 104q10 9 20 0" stroke="#fff" stroke-width="4" fill="none" stroke-linecap="round"/></svg>
                          </div>
                        )}
                        {a.cle === 'icones' && (
                          <div class="accueil-tel">
                            {Array.from({ length: 11 }, (_, k) => <i class="app-ic" style={`--k:${k}`}></i>)}
                            <i class="app-ic app-ic--droplet"><b></b></i>
                          </div>
                        )}
                        {a.cle === 'badge' && (
                          <div class="profil">
                            <span class="profil__avatar">A</span>
                            <p class="profil__nom">Amina <span class="badge-pro"><svg viewBox="0 0 24 24"><path d="M12 3l2.4 1.6 2.9-.2.9 2.8 2.3 1.8-1 2.7 1 2.7-2.3 1.8-.9 2.8-2.9-.2L12 21l-2.4-1.6-2.9.2-.9-2.8-2.3-1.8 1-2.7-1-2.7 2.3-1.8.9-2.8 2.9.2z"/><path d="M8.5 12l2.3 2.3 4.7-4.6" stroke="#fff" fill="none" stroke-width="2" stroke-linecap="round"/></svg></span></p>
                            <p class="profil__etat">en ligne · à portée</p>
                          </div>
                        )}
                      </div>
                    </div>
                    <i class="tel__reflet"></i>
                  </div>
                </div>
              ))}
            </div>
            <button class="rond rond--fermer" type="button" id="demo-fermer" aria-label="Fermer"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
          </div>
          <div class="points" id="points">{avantages.map(() => <i></i>)}</div>
          <div class="demo__texte">
            <h3 id="demo-titre"></h3>
            <p id="demo-long"></p>
          </div>
          <div class="demo__bas">
            <button class="cta" type="button" data-payer><span>Débloquer pour <b class="prix-courant">1 000</b> F</span><i class="cta__reflet"></i></button>
          </div>
        </section>

        <!-- ═══ 3. LE PAIEMENT ═══ -->
        <section class="feuille feuille--paiement" id="paiement" aria-hidden="true" aria-label="Paiement Mobile Money">
          <div class="poignee"></div>
          <button class="rond rond--fermer rond--clair" type="button" id="paiement-fermer" aria-label="Fermer"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>

          <div class="etape" data-etape="saisie">
            <p class="recap"><span id="recap-nom">Droplet Pro</span> · <span id="recap-duree">une fois, à vie</span></p>
            <p class="montant"><b id="montant">1 000</b> F</p>
            <h3 class="etape__titre">Payer maintenant</h3>
            <p class="etape__aide">MTN Mobile Money ou Orange Money, depuis ce téléphone ou un autre.</p>
            <div class="operateurs" role="radiogroup" aria-label="Opérateur">
              <button type="button" role="radio" aria-checked="true" data-op="mtn" style="--op:#FFCC00;--encre:#1A1400">MTN MoMo</button>
              <button type="button" role="radio" aria-checked="false" data-op="orange" style="--op:#FF7900;--encre:#fff">Orange Money</button>
            </div>
            <label class="champ">
              <span class="champ__indicatif">+237</span>
              <input id="numero" inputmode="numeric" autocomplete="off" placeholder="6XX XX XX XX" maxlength="12" aria-label="Numéro qui va payer (9 chiffres)" />
            </label>
            <p class="etape__aide etape__aide--petit">Entrez le numéro qui va payer (9 chiffres). Prototype : rien n'est envoyé.</p>
            <button class="cta" type="button" id="payer" disabled><span>Payer <b class="prix-courant">1 000</b> F</span><i class="cta__reflet"></i></button>
            <details class="main">
              <summary>Ou payer à la main</summary>
              <p>Si l'invite n'arrive pas sur votre téléphone, ou si vous préférez envoyer l'argent vous-même : composez <code id="code-op">*126#</code>, puis envoyez le montant au numéro Droplet affiché dans l'app.</p>
            </details>
          </div>

          <div class="etape" data-etape="attente" hidden>
            <div class="sonnerie" aria-hidden="true"><span></span><span></span><svg viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2" stroke-linecap="round"/></svg></div>
            <h3 class="etape__titre">Validez sur votre téléphone</h3>
            <p class="etape__aide">Composez votre code Mobile Money quand l'invite s'affiche.</p>
            <p class="attente"><span class="roue"></span> En attente de votre code…</p>
          </div>

          <div class="etape" data-etape="succes" hidden>
            <canvas class="bouquet" id="bouquet" aria-hidden="true"></canvas>
            <div class="embleme embleme--petit" aria-hidden="true"><svg viewBox="0 0 120 140"><path d="M60 6C60 6 16 58 16 88a44 44 0 0 0 88 0C104 58 60 6 60 6z" fill="url(#g-goutte)" /><path d="M60 6C60 6 16 58 16 88a44 44 0 0 0 88 0C104 58 60 6 60 6z" fill="url(#g-reflet)" /></svg></div>
            <h3 class="etape__titre" id="succes-titre">Droplet Pro activé</h3>
            <p class="etape__aide" id="succes-texte">Le badge Pro accompagne votre nom, et toutes les icônes et tous les fonds vous sont ouverts.</p>
            <button class="cta" type="button" id="termine"><span>Terminé</span><i class="cta__reflet"></i></button>
          </div>
        </section>
      </div>
    </div>
    <aside class="note">
      <b>Prototype de l'écran Droplet Pro</b>
      <span>Touchez un avantage, faites glisser les téléphones, puis « Débloquer ». Aucun paiement réel : rien n'est envoyé.</span>
    </aside>
  </div>

  <script id="donnees" type="application/json" set:html={JSON.stringify({ avantages, palette })}></script>
  <script>
    import '../../scripts/pro';
  </script>
</body>
</html>

<style is:global>
  @font-face { font-family: 'Commissioner'; src: url('/fonts/commissioner.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'Martian Mono'; src: url('/fonts/martian-mono.woff2') format('woff2'); font-weight: 100 800; font-display: swap; }
  :root { color-scheme: dark; --sortie: cubic-bezier(0.23, 1, 0.32, 1); --ressort: cubic-bezier(0.34, 1.4, 0.5, 1); --accent: #0A84FF; --grad: linear-gradient(90deg, #6C51FF, #B44BF0 20%, #F2586B 38%, #FFA932 50%, #F2586B 62%, #B44BF0 80%, #6C51FF); }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html, body { margin: 0; height: 100%; background: #0b0b0d; }
  body { font-family: 'Commissioner', system-ui, sans-serif; color: #fff; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  svg { display: block; }

  /* ── Le téléphone ─────────────────────────────────────────── */
  .scene { min-height: 100%; display: grid; grid-template-columns: auto minmax(0, 280px); gap: 48px; align-items: center; justify-content: center; padding: 32px; }
  .appareil { position: relative; width: 402px; height: 874px; padding: 11px; border-radius: 64px; background: #1a1a1c; box-shadow: inset 0 0 0 2px #3a3a3e, inset 0 0 0 5px #0d0d0f, 0 40px 80px -30px rgb(0 0 0 / 0.8); }
  .ilot { position: absolute; z-index: 30; top: 22px; left: 50%; width: 120px; height: 34px; margin-left: -60px; border-radius: 20px; background: #000; }
  .ecran { position: relative; width: 100%; height: 100%; border-radius: 54px; overflow: hidden; background: #000; isolation: isolate; }
  .note { display: grid; gap: 8px; color: #8d8d93; font-size: 14px; line-height: 1.5; }
  .note b { color: #fff; font-size: 16px; }
  @media (max-width: 760px) {
    .scene { display: block; padding: 0; }
    .appareil { width: 100%; height: 100dvh; padding: 0; border-radius: 0; box-shadow: none; background: #000; }
    .ilot, .note { display: none; }
    .ecran { border-radius: 0; }
  }

  /* ── La barre du haut : le titre apparaît quand l'emblème passe dessous ── */
  .nav { position: absolute; z-index: 5; inset: 0 0 auto 0; display: flex; align-items: center; justify-content: space-between; padding: 58px 16px 10px; transition: background-color 200ms; }
  .nav.est-defilee { background: rgb(0 0 0 / 0.88); backdrop-filter: blur(20px); box-shadow: 0 0.5px 0 rgb(255 255 255 / 0.12); }
  .nav__titre { margin: 0; font-weight: 650; font-size: 17px; opacity: 0; transform: translateY(6px); transition: opacity 200ms, transform 300ms var(--sortie); }
  .nav.est-defilee .nav__titre { opacity: 1; transform: none; }
  @media (max-width: 760px) { .nav { padding-top: max(14px, env(safe-area-inset-top)); } }

  /* Le rond de verre : gonfle sous le doigt (BoutonVerre de l'app). */
  .rond { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: rgb(255 255 255 / 0.12); box-shadow: inset 0 0.5px 0 rgb(255 255 255 / 0.35); backdrop-filter: blur(14px); transition: transform 220ms var(--ressort), background-color 150ms; }
  .rond:active { transform: scale(1.12); background: rgb(255 255 255 / 0.2); }
  .rond svg { width: 20px; height: 20px; fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .rond--vide { visibility: hidden; }

  .defile { position: absolute; inset: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 16px; scrollbar-width: none; }
  .defile::-webkit-scrollbar { display: none; }

  /* ── 1. Le héros : l'emblème dans un tourbillon d'étoiles ── */
  .heros { position: relative; text-align: center; padding-top: 96px; }
  .heros__etoiles { position: absolute; left: 50%; top: 40px; width: 380px; height: 240px; margin-left: -190px; pointer-events: none; }
  .embleme { position: relative; width: 112px; height: 130px; margin: 0 auto; filter: drop-shadow(0 18px 40px rgb(225 81 176 / 0.45)); animation: flotte 4.5s ease-in-out infinite; }
  .embleme svg { width: 100%; height: 100%; }
  @keyframes flotte { 50% { transform: translateY(-6px) rotate(-2deg); } }
  .heros h1 { margin: 22px 0 8px; font-size: 30px; font-weight: 720; letter-spacing: -0.02em; font-variation-settings: 'FLAR' 70, 'VOLM' 30; }
  .heros__texte { margin: 0 auto; max-width: 31ch; color: #aeaeb2; font-size: 15.5px; line-height: 1.42; }
  .garanties { list-style: none; display: flex; justify-content: center; flex-wrap: wrap; gap: 6px; padding: 0; margin: 18px 0 26px; }
  .garanties li { padding: 5px 10px; border-radius: 99px; background: rgb(255 255 255 / 0.08); color: #d1d1d6; font-size: 12.5px; font-weight: 550; }

  /* ── Les listes groupées, comme les réglages d'iOS ── */
  .groupe { list-style: none; margin: 0; padding: 0; border-radius: 16px; background: #1c1c1e; overflow: hidden; }
  .groupe li + li > * { box-shadow: inset 0 0.5px 0 rgb(84 84 88 / 0.65); }
  .avantages li + li > * { box-shadow: none; }
  .avantages li + li .avantage__txt { box-shadow: inset 0 0.5px 0 rgb(84 84 88 / 0.65); }

