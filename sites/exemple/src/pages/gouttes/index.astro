---
// ============================================================================
// PROTOTYPE — les Gouttes de Droplet, à la façon des étoiles de Telegram.
// ----------------------------------------------------------------------------
// Les écrans de l'app, dans un vrai téléphone, à valider AVANT le Flutter :
//   1. Mes Gouttes : le solde, Recharger / Offrir, la boutique, l'historique ;
//   2. Recharger : le palier, l'opérateur, le numéro, l'attente, le succès ;
//   3. Acheter (ou offrir) un article, avec « il vous manque… » si besoin ;
//   4. Le reçu d'une ligne d'historique ;
//   5. « Comment ça marche » : ce que sont les Gouttes, et ce qu'elles ne sont pas.
// Les prix et paliers sont ceux du service (droplet-pay/src/catalogue.js).
// Idée reprise de Telegram (StarsTransactionsScreen, StarsPurchaseScreen,
// BalanceNeededScreen), rien n'est copié : Telegram iOS est sous GPL.
// AUCUN PAIEMENT : rien n'est envoyé, tout se passe dans la page.
// ============================================================================

// Copie de droplet-pay/src/catalogue.js (version 1).
const paliers = [
  { cle: 'g50', gouttes: 50, prix: 500, bonus: 0 },
  { cle: 'g100', gouttes: 100, prix: 1000, bonus: 0 },
  { cle: 'g250', gouttes: 260, prix: 2500, bonus: 10 },
  { cle: 'g500', gouttes: 530, prix: 5000, bonus: 30 },
];
const familles = [
  { cle: 'pro', nom: 'Pro' },
  { cle: 'personnalisation', nom: 'Style' },
  { cle: 'stickers', nom: 'Stickers' },
  { cle: 'cadeaux', nom: 'Cadeaux' },
];
const produits = [
  { cle: 'pro', famille: 'pro', prix: 100, nom: 'Droplet Pro', court: 'À vie · vocaux en texte, traduction, badge', long: "Tout Pro, une fois pour toutes : les vocaux en texte, la traduction sur le téléphone, la mise en forme, les autocollants animés, les icônes et le badge.", icone: 'badge', c: '#8E4FFF' },
  { cle: 'pack_premium', famille: 'personnalisation', prix: 50, nom: 'Icônes et fonds', court: 'Dix icônes, huit fonds', long: "Dix icônes d'app et huit fonds dessinés à la main. À vous pour toujours, sur tous vos téléphones.", icone: 'fond', c: '#E151B0' },
  { cle: 'stickers_droplet', famille: 'stickers', prix: 15, nom: 'Stickers Droplet', court: 'La goutte, en mouvement', long: "La goutte Droplet, animée image par image. Assez légère pour voyager par le maillage, sans Internet.", icone: 'goutte', c: '#0A84FF' },
  { cle: 'stickers_gerbes', famille: 'stickers', prix: 15, nom: 'Stickers Gerbes', court: 'Des fleurs pour tout dire', long: "Un pack de gerbes animées, pour féliciter, remercier, ou s'excuser sans écrire un mot.", icone: 'fleur', c: '#F2586B' },
  { cle: 'stickers_personnage', famille: 'stickers', prix: 15, nom: 'Stickers Personnage', court: 'Un petit personnage expressif', long: "Un personnage qui rit, boude, applaudit. Pour les conversations où un mot ne suffit pas.", icone: 'visage', c: '#F97C3C' },
  { cle: 'cadeau_goutte_doree', famille: 'cadeaux', prix: 25, nom: 'Goutte dorée', court: "S'affiche sur le profil", long: "Une goutte d'or, posée sur le profil de la personne. Elle voit qui la lui a offerte.", icone: 'goutte', c: '#E8930C' },
  { cle: 'cadeau_bouquet', famille: 'cadeaux', prix: 50, nom: 'Bouquet', court: "S'affiche sur le profil", long: "Un bouquet qui reste sur le profil. Pour un anniversaire, un examen réussi, ou rien de particulier.", icone: 'fleur', c: '#E151B0' },
  { cle: 'cadeau_comete', famille: 'cadeaux', prix: 100, nom: 'Comète', court: "Le plus rare, sur le profil", long: "Une comète qui traverse le profil de temps en temps. Le cadeau qu'on remarque.", icone: 'comete', c: '#6C51FF' },
];
const contacts = [
  { cle: 'amina', nom: 'Amina', initiale: 'A', c: '#E59A4C' },
  { cle: 'michel', nom: 'Michel', initiale: 'M', c: '#5E8BFF' },
  { cle: 'grace', nom: 'Grâce', initiale: 'G', c: '#3DBB8A' },
];
// L'historique de départ : 50 − 15 = 35 (assez peu pour voir « il vous manque »).
const historique = [
  { id: 'op-3', nature: 'achat', titre: 'Stickers Gerbes', montant: -15, date: 'Aujourd’hui, 18:42', icone: 'fleur', c: '#F2586B', ref: '7c1e2a90-55b1-4d0e-9a2f-3e8d4c61b0a7' },
  { id: 'op-2', nature: 'recharge', titre: 'Recharge Orange Money', montant: 50, date: 'Hier, 09:15', op: 'orange', prix: 500, ref: 'a3f04d1c-2b8e-4f7a-8c55-91d0e6b2f348' },
];
const icones: Record<string, string> = {
  badge: '<path d="M12 3l2.4 1.6 2.9-.2.9 2.8 2.3 1.8-1 2.7 1 2.7-2.3 1.8-.9 2.8-2.9-.2L12 21l-2.4-1.6-2.9.2-.9-2.8-2.3-1.8 1-2.7-1-2.7 2.3-1.8.9-2.8 2.9.2z"/><path d="M8.5 12l2.3 2.3 4.7-4.6" stroke-linecap="round" stroke-linejoin="round"/>',
  fond: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M4 15l5-5 4 4 3-3 4 4" stroke-linejoin="round"/>',
  goutte: '<path d="M12 3.5S6 10.2 6 14a6 6 0 0 0 12 0c0-3.8-6-10.5-6-10.5z" stroke-linejoin="round"/>',
  fleur: '<circle cx="12" cy="9" r="2.2"/><path d="M12 6.8c0-2.4 3-2.4 3 0M14.2 9c2.4 0 2.4 3 0 3M12 11.2c0 2.4-3 2.4-3 0M9.8 9c-2.4 0-2.4-3 0-3M12 11.5V21M12 17c-2-2-4-2-5-1M12 15c2-2 4-2 5-1" stroke-linecap="round"/>',
  visage: '<circle cx="12" cy="12" r="8.5"/><path d="M8.5 14.5c1.8 2 5.2 2 7 0" stroke-linecap="round"/><path d="M9 9.5v1M15 9.5v1" stroke-linecap="round"/>',
  comete: '<circle cx="16.5" cy="7.5" r="3"/><path d="M14.3 9.7L4 20M12.5 7.2L6 13.7M16.8 11.5L10.3 18" stroke-linecap="round"/>',
};
const pile = (n: number) => Array.from({ length: n }, (_, i) => i);
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Gouttes Droplet — prototype</title>
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/commissioner.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <linearGradient id="g-or" x1="0.2" y1="0" x2="0.8" y2="1">
        <stop offset="0" stop-color="#FFF0BF" /><stop offset="0.38" stop-color="#FFC53D" /><stop offset="1" stop-color="#E07B00" />
      </linearGradient>
      <radialGradient id="g-or-reflet" cx="0.36" cy="0.32" r="0.55">
        <stop offset="0" stop-color="#fff" stop-opacity="0.9" /><stop offset="0.4" stop-color="#fff" stop-opacity="0.15" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
      </radialGradient>
      <symbol id="goutte" viewBox="0 0 120 140">
        <path d="M60 6C60 6 16 58 16 88a44 44 0 0 0 88 0C104 58 60 6 60 6z" fill="url(#g-or)" />
        <path d="M60 6C60 6 16 58 16 88a44 44 0 0 0 88 0C104 58 60 6 60 6z" fill="url(#g-or-reflet)" />
        <path d="M60 6C60 6 16 58 16 88a44 44 0 0 0 88 0C104 58 60 6 60 6z" fill="none" stroke="#7A4300" stroke-opacity="0.35" stroke-width="3" />
        <path d="M42 76c-4 8-4 17 2 24" stroke="#fff" stroke-opacity="0.75" stroke-width="6" stroke-linecap="round" fill="none" />
      </symbol>
    </defs>
  </svg>

  <div class="scene">
    <div class="appareil" id="appareil">
      <div class="ilot" aria-hidden="true"></div>
      <div class="ecran" id="ecran">

        <!-- ═══ 1. MES GOUTTES ═══ -->
        <header class="nav" id="nav">
          <button class="rond" type="button" aria-label="Retour"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
          <p class="nav__titre"><svg class="g" aria-hidden="true"><use href="#goutte"/></svg><span id="nav-solde">35</span></p>
          <button class="rond" type="button" id="info" aria-label="Comment ça marche"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5M12 7.6v.1"/></svg></button>
        </header>

        <div class="defile" id="defile">
          <section class="heros">
            <div class="embleme" id="embleme" aria-hidden="true"><svg><use href="#goutte"/></svg><i class="embleme__eclat"></i></div>
            <p class="solde" aria-live="polite"><b id="solde">35</b><span>Gouttes</span></p>
            <p class="heros__texte">Achetées par Mobile Money, dépensées dans Droplet.</p>
            <div class="actions">
              <button class="cta cta--or" type="button" id="recharger"><span>Recharger</span></button>
              <button class="verre" type="button" id="offrir"><svg viewBox="0 0 24 24"><rect x="4" y="9" width="16" height="11" rx="2"/><path d="M3.5 9h17M12 9v11M12 9c-1.5-4-6-4-5-1.5S12 9 12 9zm0 0c1.5-4 6-4 5-1.5S12 9 12 9z" stroke-linejoin="round"/></svg>Offrir</button>
            </div>
          </section>

          <div class="pour" id="pour" hidden>
            <span class="avatar" id="pour-avatar">A</span>
            <span class="pour__txt">Vous choisissez un cadeau pour <b id="pour-nom">Amina</b></span>
            <button type="button" class="pour__annuler" id="pour-annuler">Annuler</button>
          </div>

          <h2 class="intertitre">Boutique</h2>
          <div class="segments" role="tablist" aria-label="Rayons" id="rayons">
            {familles.map((f, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-famille={f.cle}>{f.nom}</button>)}
          </div>
          <ul class="groupe articles" id="articles">
            {produits.map((p) => (
              <li data-famille={p.famille} hidden={p.famille !== 'pro'}><button class="ligne" type="button" data-produit={p.cle}>
                <span class="carre" style={`--c:${p.c}`}><svg viewBox="0 0 24 24" set:html={icones[p.icone]} /></span>
                <span class="ligne__txt"><b>{p.nom}</b><small>{p.court}</small></span>
                <span class="prix" data-prix-de={p.cle}><svg class="g" aria-hidden="true"><use href="#goutte"/></svg>{p.prix}</span>
              </button></li>
            ))}
          </ul>

          <h2 class="intertitre">Historique</h2>
          <div class="segments" role="tablist" aria-label="Filtre de l'historique" id="filtres">
            <button type="button" role="tab" aria-selected="true" data-filtre="tout">Tout</button>
            <button type="button" role="tab" aria-selected="false" data-filtre="recharge">Recharges</button>
            <button type="button" role="tab" aria-selected="false" data-filtre="achat">Dépenses</button>
          </div>
          <ul class="groupe" id="historique"></ul>

          <p class="pied">Les Gouttes ne se retirent pas et ne se revendent pas. <button type="button" class="lien" id="info-bas">Comment ça marche</button></p>
          <div class="reserve"></div>
        </div>

        <div class="voile" id="voile" hidden></div>

        <!-- ═══ 2. RECHARGER ═══ -->
        <section class="feuille" id="recharge" aria-hidden="true" aria-label="Recharger des Gouttes">
          <div class="poignee"></div>
          <button class="rond rond--fermer" type="button" data-fermer aria-label="Fermer"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
          <span class="bac">Bac à sable</span>

          <div class="etape" data-etape="palier">
            <h3 class="etape__titre etape__titre--haut">Recharger des Gouttes</h3>
            <p class="etape__aide" id="manque-aide" hidden></p>
            <ul class="groupe groupe--clair paliers" role="radiogroup" aria-label="Palier">
              {paliers.map((p, i) => (
                <li><button class="ligne" type="button" role="radio" aria-checked={i === 1 ? 'true' : 'false'} data-palier={p.cle} data-gouttes={p.gouttes} data-prix={p.prix}>
                  <span class="pile" style={`--n:${i + 1}`}>{pile(i + 1).map((k) => <svg style={`--k:${k}`}><use href="#goutte"/></svg>)}</span>
                  <span class="ligne__txt"><b>{p.gouttes} Gouttes</b>{p.bonus ? <small class="offertes">dont {p.bonus} offertes</small> : <small>&nbsp;</small>}</span>
                  <span class="palier__prix">{p.prix.toLocaleString('fr-FR')} F</span>
                </button></li>
              ))}
            </ul>
            <button class="cta cta--or" type="button" id="continuer"><span>Continuer · <b id="continuer-prix">1 000</b> F</span></button>
            <p class="etape__aide etape__aide--petit">1 Goutte = 10 F. Les plus gros paliers en donnent un peu plus.</p>
          </div>

          <div class="etape" data-etape="paiement" hidden>
            <p class="recap" id="recap">100 Gouttes</p>
            <p class="montant"><b id="montant">1 000</b> F</p>
            <div class="operateurs" role="radiogroup" aria-label="Opérateur">
              <button type="button" role="radio" aria-checked="true" data-op="mtn" style="--op:#FFCC00;--encre:#1A1400">MTN MoMo</button>
              <button type="button" role="radio" aria-checked="false" data-op="orange" style="--op:#FF7900;--encre:#fff">Orange Money</button>
            </div>
            <label class="champ">
              <span class="champ__indicatif">+237</span>
              <input id="numero" inputmode="numeric" autocomplete="off" placeholder="6XX XX XX XX" maxlength="12" aria-label="Numéro qui va payer (9 chiffres)" />
            </label>
            <p class="etape__aide etape__aide--petit">Votre opérateur vous demandera votre code secret sur votre téléphone. Droplet ne le demande jamais.</p>
            <button class="cta cta--or" type="button" id="payer" disabled><span>Payer <b class="prix-courant">1 000</b> F</span></button>
          </div>

          <div class="etape" data-etape="attente" hidden>
            <div class="sonnerie" aria-hidden="true"><span></span><span></span><svg viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2" stroke-linecap="round"/></svg></div>
            <h3 class="etape__titre">Validez sur votre téléphone</h3>
            <p class="etape__aide" id="attente-aide">Tapez votre code MTN MoMo dans l'invite qui s'affiche.</p>
            <p class="attente"><span class="roue"></span> En attente de la confirmation de l'opérateur…</p>
          </div>

          <div class="etape" data-etape="succes" hidden>
            <div class="pluie" id="pluie" aria-hidden="true"></div>
            <div class="embleme embleme--petit" aria-hidden="true"><svg><use href="#goutte"/></svg></div>
            <h3 class="etape__titre"><span id="succes-gouttes">+100</span> Gouttes</h3>
            <p class="etape__aide">Confirmé par l'opérateur. Elles sont à vous, sur tous vos téléphones Droplet.</p>
            <button class="cta cta--or" type="button" data-fermer><span>Terminé</span></button>
          </div>
        </section>

        <!-- ═══ 3. ACHETER OU OFFRIR ═══ -->
        <section class="feuille" id="achat" aria-hidden="true" aria-label="Acheter">
          <div class="poignee"></div>
          <button class="rond rond--fermer" type="button" data-fermer aria-label="Fermer"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>

          <div class="etape" data-etape="resume">
            <span class="carre carre--grand" id="achat-icone"></span>
            <h3 class="etape__titre" id="achat-nom">Droplet Pro</h3>
            <p class="etape__aide" id="achat-texte"></p>
            <ul class="groupe groupe--clair recap-achat">
              <li><span>Pour</span><b id="achat-pour">Moi</b></li>
              <li><span>Prix</span><b><svg class="g" aria-hidden="true"><use href="#goutte"/></svg><span id="achat-prix">100</span></b></li>
              <li><span>Solde après</span><b id="achat-apres">35</b></li>
            </ul>
            <button class="cta cta--or" type="button" id="acheter"><span id="acheter-txt">Acheter</span></button>
            <button class="lien" type="button" id="achat-offrir">Offrir à quelqu'un</button>
          </div>

          <div class="etape" data-etape="succes" hidden>
            <div class="pluie" aria-hidden="true"></div>
            <span class="carre carre--grand carre--eclot" id="fait-icone"></span>
            <h3 class="etape__titre" id="fait-titre">C'est à vous</h3>
            <p class="etape__aide" id="fait-texte"></p>
            <button class="cta cta--or" type="button" data-fermer><span>Terminé</span></button>
          </div>
        </section>

        <!-- ═══ OFFRIR : à qui ═══ -->
        <section class="feuille" id="contacts" aria-hidden="true" aria-label="Offrir à">
          <div class="poignee"></div>
          <button class="rond rond--fermer" type="button" data-fermer aria-label="Fermer"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
          <div class="etape">
            <h3 class="etape__titre etape__titre--haut">Offrir à…</h3>
            <p class="etape__aide">On offre un article, pas des Gouttes : la personne le reçoit, et voit qui le lui a offert.</p>
            <ul class="groupe groupe--clair">
              {contacts.map((k) => (
                <li><button class="ligne" type="button" data-contact={k.cle} data-nom={k.nom} data-initiale={k.initiale} style={`--c:${k.c}`}>
                  <span class="avatar">{k.initiale}</span><span class="ligne__txt"><b>{k.nom}</b><small>Dans vos contacts Droplet</small></span>
                  <svg class="chevron" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
                </button></li>
              ))}
            </ul>
          </div>
        </section>

        <!-- ═══ 4. LE REÇU ═══ -->
        <section class="feuille" id="recu" aria-hidden="true" aria-label="Reçu">
          <div class="poignee"></div>
          <button class="rond rond--fermer" type="button" data-fermer aria-label="Fermer"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
          <div class="etape">
            <span class="carre carre--grand" id="recu-icone"></span>
            <p class="recu__montant" id="recu-montant">−15</p>
            <h3 class="etape__titre" id="recu-titre">Stickers Gerbes</h3>
            <ul class="groupe groupe--clair recap-achat" id="recu-lignes"></ul>
            <p class="scelle"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>Reçu signé par Droplet Pay, vérifié sur ce téléphone.</p>
          </div>
        </section>

        <!-- ═══ 5. COMMENT ÇA MARCHE ═══ -->
        <section class="feuille" id="explication" aria-hidden="true" aria-label="Comment ça marche">
          <div class="poignee"></div>
          <button class="rond rond--fermer" type="button" data-fermer aria-label="Fermer"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
          <div class="etape">
            <div class="embleme embleme--petit" aria-hidden="true"><svg><use href="#goutte"/></svg></div>
            <h3 class="etape__titre">Les Gouttes</h3>
            <ul class="groupe groupe--clair faits">
              <li><b>On les achète</b><span>Par MTN MoMo ou Orange Money. Elles sont créditées quand l'opérateur confirme, pas avant.</span></li>
              <li><b>On les dépense dans Droplet</b><span>Pro, styles, stickers, cadeaux. Pour soi, ou pour quelqu'un.</span></li>
              <li><b>Elles ne se retirent pas</b><span>Ce ne sont pas de l'argent : elles ne se revendent pas et ne s'envoient pas nues.</span></li>
              <li><b>Elles suivent votre compte</b><span>Pas votre téléphone : un nouveau téléphone sur le même Droplet ID les retrouve.</span></li>
              <li><b>Droplet ne voit pas vos messages</b><span>Le paiement passe par un serveur à part, qui ne touche ni aux conversations ni au maillage.</span></li>
            </ul>
          </div>
        </section>
      </div>
    </div>
    <aside class="note">
      <b>Prototype des Gouttes</b>
      <span>Rechargez, achetez, offrez, touchez une ligne de l'historique. Essayez d'acheter la Comète sans assez de Gouttes. Aucun paiement réel : rien n'est envoyé.</span>
    </aside>
  </div>

  <script id="donnees" type="application/json" set:html={JSON.stringify({ produits, historique, icones })}></script>
  <script>
    import '../../scripts/gouttes';
  </script>
</body>
</html>

<style is:global>
  @font-face { font-family: 'Commissioner'; src: url('/fonts/commissioner.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'Martian Mono'; src: url('/fonts/martian-mono.woff2') format('woff2'); font-weight: 100 800; font-display: swap; }
  :root { color-scheme: dark; --sortie: cubic-bezier(0.23, 1, 0.32, 1); --ressort: cubic-bezier(0.34, 1.4, 0.5, 1); --accent: #0A84FF;
    --or-clair: #FFF0BF; --or: #FFC53D; --or-profond: #E07B00; --encre-or: #3A2400; --surface: #1c1c1e; --surface-2: #2c2c2e; --trait: rgb(84 84 88 / 0.65); --gris: #8d8d93; --vert: #32D74B; }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html, body { margin: 0; height: 100%; background: #0b0b0d; }
  body { font-family: 'Commissioner', system-ui, sans-serif; color: #fff; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  svg { display: block; }
